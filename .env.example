# BrillPrime local client configuration template.
# Copy this file to .env locally and fill values from the relevant provider consoles.
# Never put database passwords, Supabase service-role keys, private keys, or admin SDK credentials here.
# EXPO_PUBLIC_* values are bundled into the client app and are visible to users.

EXPO_PUBLIC_EAS_PROJECT_ID=aa9abbbe-13a1-44d5-91b0-b65256603d1b

# Firebase client configuration (client-visible; restrict provider-side usage as appropriate)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Supabase client configuration only; never use a service-role key in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Client-visible Maps key. Restrict it by Android package/signing certificate and APIs.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional runtime settings
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false
EXPO_PUBLIC_DEBUG_MODE=false
